---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const JOURNAL_COLLECTION = "journal";

const tags = await getTaxonomy(JOURNAL_COLLECTION, "tags");
const allTags = await getAllTaxonomy(JOURNAL_COLLECTION, "tags");
const tagCounts = allTags.reduce((counts: Record<string, number>, tag: string) => {
  counts[tag] = (counts[tag] || 0) + 1;
  return counts;
}, {});
const sortedTags = [...tags].sort(
  (a: string, b: string) =>
    (tagCounts[b] || 0) - (tagCounts[a] || 0) || a.localeCompare(b),
);
---

<Base title={"Tags"} noindex={true}>
  <PageHeader title={"Tags"} />
  <section class="section">
    <div class="container text-center">
      <ul>
        {
          sortedTags.map((tag: any) => {
            const count = tagCounts[tag] || 0;
            return (
              <li class="m-3 inline-block">
                <a
                  href={`/tags/${tag}`}
                  class="block rounded bg-light px-4 py-2 text-xl text-text-dark dark:bg-darkmode-light dark:text-darkmode-text-dark"
                >
                  {humanize(tag)}{" "}
                  <span class="ml-2 rounded bg-body px-2 dark:bg-darkmode-body">
                    {count}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
