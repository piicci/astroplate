---
import Base from "@/layouts/Base.astro";
import BreakfastGuideForm from "@/layouts/components/BreakfastGuideForm.astro";
---

<Base
  title="7 High-Protein Breakfasts"
  meta_title="7 High-Protein Breakfasts | Becoming Elysian"
  description="Get the Becoming Elysian breakfast guide with seven protein-rich breakfast ideas for steadier energy, fewer cravings, and calmer mornings."
  image="/images/journal/becoming-elysian-serene-morning-breakfast-hero.webp"
>
  <section class="breakfast-guide-page">
    <div class="container breakfast-guide-shell">
      <div class="breakfast-guide-copy">
        <p class="breakfast-guide-eyebrow">Breakfast guide</p>
        <h1>7 high-protein breakfasts for steadier mornings</h1>
        <p class="breakfast-guide-lede">
          A simple PDF for the mornings when coffee is doing too much of the
          work. Get seven balanced breakfast ideas designed to support energy,
          fullness, and a gentler rhythm through the first half of the day.
        </p>
        <div class="breakfast-guide-points" aria-label="What is inside the guide">
          <p>Inside the guide</p>
          <ul>
            <li>Seven breakfast ideas with protein, fiber, and satisfying fats.</li>
            <li>Options for quick mornings, low-appetite mornings, and prep-ahead days.</li>
            <li>A calm way to make breakfast more supportive without making it complicated.</li>
          </ul>
        </div>
      </div>

      <div class="breakfast-guide-image" aria-hidden="true">
        <img
          src="/images/journal/becoming-elysian-serene-morning-breakfast-hero.webp"
          alt=""
          loading="eager"
        />
      </div>

      <div class="breakfast-guide-form-panel">
        <p class="breakfast-guide-panel-kicker">Send me the PDF</p>
        <h2>Start with one breakfast that gives something back.</h2>
        <BreakfastGuideForm
          idPrefix="breakfast-guide-page"
          source="breakfast-guide-page"
          className="breakfast-guide-page-form"
        />
      </div>
    </div>
  </section>

  <style>
    .breakfast-guide-page {
      overflow-x: clip;
      padding: clamp(3.5rem, 7vw, 6.5rem) 0 clamp(4rem, 8vw, 7rem);
      background:
        linear-gradient(112deg, transparent 0%, rgba(154, 103, 64, 0.052) 16%, transparent 30%),
        radial-gradient(circle at 82% 8%, rgba(232, 215, 189, 0.34), transparent 28rem),
        linear-gradient(180deg, rgba(248, 241, 230, 0.98), rgba(255, 249, 239, 0.78));
    }

    .breakfast-guide-shell {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .breakfast-guide-copy,
    .breakfast-guide-form-panel {
      min-width: 0;
    }

    .breakfast-guide-eyebrow,
    .breakfast-guide-panel-kicker {
      margin: 0 0 1.15rem;
      color: #8e9475;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .breakfast-guide-page h1 {
      max-width: 12ch;
      margin: 0;
      color: #2a251d;
      font-size: clamp(2.7rem, 5vw, 5.2rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 0.96;
    }

    .breakfast-guide-lede {
      max-width: 45rem;
      margin: clamp(1.5rem, 3vw, 2.2rem) 0 0;
      color: #4b3b25;
      font-size: clamp(1.04rem, 1.35vw, 1.2rem);
      line-height: 1.66;
    }

    .breakfast-guide-points {
      max-width: 43rem;
      margin-top: clamp(2rem, 4vw, 3rem);
      padding-top: 1.4rem;
      border-top: 1px solid rgba(138, 114, 76, 0.28);
    }

    .breakfast-guide-points p {
      margin: 0 0 1rem;
      color: #3f4a14;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .breakfast-guide-points ul {
      display: grid;
      gap: 0.8rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .breakfast-guide-points li {
      position: relative;
      padding-left: 1.4rem;
      color: #6f5b3b;
      font-size: 1rem;
      line-height: 1.6;
    }

    .breakfast-guide-points li::before {
      position: absolute;
      top: 0.72em;
      left: 0;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: #8e9475;
      content: "";
    }

    .breakfast-guide-image {
      overflow: hidden;
      border: 1px solid rgba(138, 114, 76, 0.24);
      border-radius: 2px;
      aspect-ratio: 4 / 5;
      background: rgba(237, 226, 204, 0.7);
    }

    .breakfast-guide-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .breakfast-guide-form-panel {
      border-top: 1px solid rgba(138, 114, 76, 0.34);
      padding-top: clamp(1.5rem, 3vw, 2rem);
    }

    .breakfast-guide-form-panel h2 {
      max-width: 12ch;
      margin: 0 0 1.5rem;
      color: #2a251d;
      font-size: clamp(2rem, 3.1vw, 3rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1;
    }

    .breakfast-guide-page-form .form-input {
      background-color: rgba(247, 243, 232, 0.82);
    }

    @media (min-width: 1024px) {
      .breakfast-guide-shell {
        grid-template-columns: minmax(0, 0.92fr) minmax(18rem, 0.58fr);
      }

      .breakfast-guide-copy {
        grid-column: 1;
      }

      .breakfast-guide-image {
        grid-column: 2;
        grid-row: 1 / span 2;
        min-height: 34rem;
      }

      .breakfast-guide-form-panel {
        grid-column: 1;
        max-width: 34rem;
      }
    }

    .dark .breakfast-guide-page h1,
    .dark .breakfast-guide-form-panel h2 {
      color: #f7f3e8;
    }

    .dark .breakfast-guide-lede,
    .dark .breakfast-guide-points li {
      color: #ede2cc;
    }

    @media (max-width: 767px) {
      .breakfast-guide-shell {
        width: min(calc(100vw - 2rem), 70rem) !important;
      }

      .breakfast-guide-lede,
      .breakfast-guide-points li {
        font-size: var(--be-mobile-copy-size);
        line-height: var(--be-mobile-copy-line-height);
      }

      .breakfast-guide-image {
        aspect-ratio: 1 / 1;
      }
    }
  </style>
</Base>
