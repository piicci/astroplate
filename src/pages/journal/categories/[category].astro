---
import JournalCard from "@/components/JournalCard.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize, slugify } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

export async function getStaticPaths() {
  const JOURNAL_COLLECTION = "journal";
  const categories = await getTaxonomy(JOURNAL_COLLECTION, "categories");

  return categories.map((category) => {
    return {
      params: { category },
    };
  });
}

const { category } = Astro.params;
const JOURNAL_COLLECTION = "journal";
const siteUrl = config.site.base_url.replace(/\/$/, "");
const pageUrl = `/journal/categories/${category}`;
const absolutePageUrl = `${siteUrl}${pageUrl}`;
const posts = await getSinglePage(JOURNAL_COLLECTION);
const categoryTitle =
  posts
    .flatMap((post) => post.data.categories)
    .find((item: string) => slugify(item) === category) ||
  humanize(category || "");
const categoryLabel = categoryTitle.toLowerCase();
const description = `Explore Becoming Elysian journal articles on ${categoryLabel}, with grounded guidance for women's nutrition, energy, hormones, strength, stress, recovery, and long-term wellbeing.`;
const filterByCategories = taxonomyFilter(posts, "categories", category!);
const sortedPosts = sortByDate(filterByCategories);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: siteUrl,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Journal",
        item: `${siteUrl}/journal`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Categories",
        item: `${siteUrl}/journal/categories`,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: categoryTitle,
        item: absolutePageUrl,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${categoryTitle} Journal Articles`,
    description,
    url: absolutePageUrl,
    numberOfItems: sortedPosts.length,
  },
];
---

<Base
  title={categoryTitle}
  meta_title={`${categoryTitle} Journal Articles | ${config.site.title}`}
  description={description}
  canonical={pageUrl}
  structuredData={structuredData}
>
  <PageHeader
    title={categoryTitle}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Journal", href: "/journal" },
      { label: "Categories", href: "/journal/categories" },
      { label: categoryTitle, href: pageUrl },
    ]}
  />
  <div class="section-sm pb-0">
    <div class="container">
      <p class="mx-auto mb-12 max-w-3xl text-center text-lg leading-8 text-text-light dark:text-darkmode-text-light">
        A curated collection of Becoming Elysian journal articles on {
          categoryLabel
        }, gathered to help you move through the topic with more clarity and
        continuity.
      </p>
      <div class="row">
        {
          sortedPosts.map((post) => (
            <div class="mb-14 md:col-6 lg:col-4">
              <JournalCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>
