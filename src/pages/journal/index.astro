---
import JournalCard from "@/components/JournalCard.astro";
import Pagination from "@/components/Pagination.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import {
  getAllTaxonomy,
  getTaxonomy,
  getTaxonomyEntries,
} from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import PageHeader from "@/partials/PageHeader.astro";
import PostSidebar from "@/partials/PostSidebar.astro";

const JOURNAL_COLLECTION = "journal";
const JOURNAL_ROUTE = "journal";

const postIndex = await getListPage(JOURNAL_COLLECTION, "-index");
if (postIndex.data.draft) {
  return Astro.redirect("/404");
}

const posts = await getSinglePage(JOURNAL_COLLECTION);
const allCategories = await getAllTaxonomy(JOURNAL_COLLECTION, "categories");
const allTags = await getAllTaxonomy(JOURNAL_COLLECTION, "tags");
const categories = await getTaxonomy(JOURNAL_COLLECTION, "categories");
const tags = await getTaxonomy(JOURNAL_COLLECTION, "tags");
const categoryEntries = await getTaxonomyEntries(
  JOURNAL_COLLECTION,
  "categories",
);
const sortedPosts = sortByDate(posts);
const totalPages: number = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);
---

<Base
  title={postIndex.data.title}
  meta_title={postIndex.data.meta_title}
  image={postIndex.data.image}
  description={postIndex.data.description}
>
  <PageHeader title={postIndex?.data.title} />
  <section class="section">
    <div class="container">
      <div class="row gx-5">
        <div class="lg:col-8">
          <div class="row">
            {
              currentPosts.map((post) => (
                <div class="mb-14 md:col-6">
                  <JournalCard data={post} />
                </div>
              ))
            }
          </div>
          <Pagination
            section={JOURNAL_ROUTE}
            currentPage={1}
            totalPages={totalPages}
          />
        </div>

        <PostSidebar
          categories={categories}
          categoryEntries={categoryEntries}
          tags={tags}
          allCategories={allCategories}
          allTags={allTags}
        />
      </div>
    </div>
  </section>
</Base>
