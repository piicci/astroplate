---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { resolveOptimizedImageSrc } from "@/lib/utils/assetImages";
import config from "@/config/config.json";
import { slugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const JOURNAL_COLLECTION = "journal";
  const posts = await getSinglePage(JOURNAL_COLLECTION);

  return posts.map((post) => ({
    params: {
      single: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const {
  title,
  meta_title,
  description,
  image,
  author,
  categories,
  date,
  faq_enable,
  faq_items,
} = post.data;
const siteUrl = config.site.base_url.replace(/\/$/, "");
const postUrl = `${siteUrl}/journal/${post.id}`;
const socialImage = await resolveOptimizedImageSrc(image, {
  width: 1200,
  height: 630,
  format: "webp",
  fit: "cover",
});
const absoluteImage = socialImage
  ? socialImage.startsWith("http")
    ? socialImage
    : `${siteUrl}${socialImage.startsWith("/") ? socialImage : `/${socialImage}`}`
  : undefined;
const primaryCategory = categories?.[0];
const primaryCategorySlug = primaryCategory ? slugify(primaryCategory) : "";
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: siteUrl,
  },
  {
    "@type": "ListItem",
    position: 2,
    name: "Journal",
    item: `${siteUrl}/journal`,
  },
  ...(primaryCategory
    ? [
        {
          "@type": "ListItem",
          position: 3,
          name: primaryCategory,
          item: `${siteUrl}/journal/categories/${primaryCategorySlug}`,
        },
      ]
    : []),
  {
    "@type": "ListItem",
    position: primaryCategory ? 4 : 3,
    name: title,
    item: postUrl,
  },
];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  image: absoluteImage,
  datePublished: date?.toISOString(),
  dateModified: date?.toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  author: {
    "@type": "Person",
    name: author,
  },
  publisher: {
    "@type": "Organization",
    name: config.site.title,
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}${config.site.logo}`,
    },
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
const faqSchema =
  faq_enable && faq_items?.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq_items
          .filter((item) => item.question && item.answer)
          .map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
      }
    : undefined;
const isStructuredData = (item: unknown): item is Record<string, unknown> =>
  Boolean(item);
const maybeStructuredData: unknown[] = [
  articleSchema,
  breadcrumbSchema,
  faqSchema,
];
const structuredData = maybeStructuredData.filter(isStructuredData);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={socialImage}
  canonical={`/journal/${post.id}`}
  ogType="article"
  structuredData={structuredData}
>
  <PostSingle post={post} />
</Base>
