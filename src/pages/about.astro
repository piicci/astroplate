  }

  .about-principles span {
    padding-top: 0.48rem;
    color: var(--about-accent);
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.2;
    text-transform: uppercase;
