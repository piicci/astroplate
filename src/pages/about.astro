    overflow-x: clip;
  }

  .dark .about-magazine {
    --about-ink: #f7f3e8;
    --about-soft-ink: #ede2cc;
    --about-muted: #dcc9a7;
    --about-accent: #dce4c6;
    --about-line: rgba(220, 228, 198, 0.22);
    background:
      radial-gradient(
        circle at 14% 0%,
        rgba(220, 228, 198, 0.1),
        transparent 30rem
      ),
      linear-gradient(180deg, rgba(75, 59, 37, 0.98), rgba(54, 43, 29, 1));
  }

  .about-cover {
    position: relative;
    padding: clamp(3.75rem, 7vw, 7.8rem) 0 clamp(2rem, 4vw, 3.5rem);
  }

  .about-cover::after {
    position: absolute;
    right: max(1.5rem, 5vw);
    bottom: 1rem;
    width: min(16rem, 28vw);
    height: 1px;
    background: var(--about-accent);
    content: "";
    opacity: 0.65;
  }

  .about-cover-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(20rem, 1.12fr);
    gap: clamp(2.4rem, 6vw, 6.5rem);
    align-items: end;
  }

  .about-cover-copy {
    padding-bottom: clamp(0rem, 4vw, 4.8rem);
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    color: var(--about-accent);
    font-family: var(--font-primary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.19em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .about-kicker::before {
    flex: 0 0 auto;
    width: 3rem;
    height: 1px;
