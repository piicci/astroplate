  }

  .about-principles section {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: clamp(1.2rem, 4vw, 3.6rem);
    padding: clamp(1.7rem, 3vw, 2.35rem) 0;
