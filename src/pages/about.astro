    content: "";
    opacity: 0.72;
  }

  .about-reveal-title {
    max-width: 9.7ch;
    margin: 1.15rem 0 2rem;
    color: var(--about-ink);
    font-family: var(--font-secondary);
    font-size: clamp(3.25rem, 7.4vw, 7.9rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: 0;
  }

  .about-deck {
    max-width: 35rem;
    margin: 0;
    color: var(--about-soft-ink);
    font-family: var(--font-primary);
    font-size: clamp(1.08rem, 1.35vw, 1.24rem);
    line-height: 1.68;
  }

  .about-cover-figure {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: 0.55rem;
    border: 1px solid rgba(221, 212, 196, 0.88);
    background: rgba(255, 253, 247, 0.34);
    box-shadow: 0 32px 92px -64px rgba(23, 19, 13, 0.38);
    animation: about-rise 850ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }

  .dark .about-cover-figure {
    border-color: rgba(237, 226, 204, 0.22);
    background: rgba(247, 243, 232, 0.06);
  }

  .about-cover-image {
    display: block;
