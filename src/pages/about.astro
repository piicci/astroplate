  .about-article blockquote {
    margin: clamp(2.5rem, 5vw, 4rem) 0;
    padding: clamp(1.6rem, 3vw, 2.5rem) 0;
    border-block: 1px solid var(--about-line);
    color: var(--about-ink);
    font-family: var(--font-secondary);
    font-size: clamp(1.55rem, 2.45vw, 2.55rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: 0;
  }

  .about-topic-spread {
    display: grid;
    grid-template-columns: minmax(11rem, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-block: 1px solid var(--about-line);
