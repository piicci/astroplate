  .about-figure-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8.8;
    object-fit: cover;
    filter: contrast(1.06) saturate(1.02);
  }

  .about-principles,
  .about-figure,
  .about-topic-spread,
  .about-detail-grid,
  .about-final-note {
    content-visibility: auto;
    contain-intrinsic-size: auto 36rem;
