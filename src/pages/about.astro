    --about-soft-ink: #3c3324;
    --about-muted: #6f8790;
    --about-accent: #3f4a14;
    --about-line: rgba(63, 74, 20, 0.28);
    --about-paper: #f8f1e6;
    background:
      radial-gradient(
        circle at 12% 4%,
        rgba(255, 249, 239, 0.94),
        transparent 31rem
      ),
      radial-gradient(
        circle at 88% 9%,
        rgba(195, 199, 106, 0.16),
        transparent 32rem
      ),
      linear-gradient(
        108deg,
        transparent 0%,
        rgba(154, 103, 64, 0.055) 16%,
        transparent 29%
      ),
      linear-gradient(
        180deg,
        rgba(248, 241, 230, 0.98),
        rgba(255, 249, 239, 0.75) 54%,
        rgba(248, 241, 230, 0.98)
