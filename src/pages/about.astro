---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";

const aboutIndex = await getListPage("about", "-index");
const { title, description, meta_title, image } = aboutIndex.data;

if (aboutIndex.data.draft) {
  return Astro.redirect("/404");
}

const topics = [
  "strength, fitness, and mobility",
  "nutrition and metabolic health",
  "hormonal health after 35",
  "nervous system regulation",
  "recovery and longevity",
  "stress resilience",
  "emotional wellbeing",
  "sustainable daily rituals",
];

const credentials = [
  "Personal Training",
  "Bodybuilding Specialist",
  "Sports Nutrition",
  "Elite Trainer",
];

const experience = [
  "stress and burnout",
  "body composition goals",
  "sustainable fitness routines",
  "mobility and recovery",
  "nutrition habits",
  "nervous system overwhelm",
  "long-term wellness and lifestyle change",
];

const principles = [
  {
    title: "Evidence over noise",
    content:
      "Clear, practical guidance shaped by real training, nutrition knowledge, and the lived experience of women just like you.",
  },
  {
    title: "Regulation before intensity",
    content:
      "Strength, nourishment, recovery, and nervous system care work together as one connected system that honours where you are.",
  },
  {
    title: "Sustainable by design",
    content:
      "Everything here is created for habits you can return to season after season, without pausing your real life.",
  },
];

const heroImage = "/images/becoming-elysian-about-cover-q1oar.jpg";
const articleImage = "/images/becoming-elysian-about-editorial.png";
const heroTitle = "Health, without the harsh edges.";
const revealQuote =
  "Wellness should help you feel more supported, energized, resilient, and gently at home in your body. Not more overwhelmed. Not more behind. Not like your body is one more thing that needs fixing.";

const revealWords = (text: string, step: number) =>
  text
    .trim()
    .split(/\s+/)
    .map((word, index) => ({
      word,
      delay: `${index * step}ms`,
    }));

const heroTitleWords = revealWords(heroTitle, 62);
const revealQuoteWords = revealWords(revealQuote, 28);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <div class="about-magazine">
    <section class="about-cover" aria-labelledby="about-cover-title">
      <div class="container">
        <div class="about-cover-grid">
          <div class="about-cover-copy">
            <p class="about-kicker">About Becoming Elysian</p>
            <h1
              class="about-reveal-title about-reveal-text"
              id="about-cover-title"
            >
              {
                heroTitleWords.map(({ word, delay }) => (
                  <span
                    class="about-reveal-word"
                    style={`--about-word-delay: ${delay}`}
                  >
                    {word}{" "}
                  </span>
                ))
              }
            </h1>
            <p class="about-deck">
              Becoming Elysian is a modern wellness space for women over 35 who
              want to feel stronger, steadier, and more at home in their bodies
              — without turning wellbeing into another thing to perfect.
            </p>
          </div>

          <figure class="about-cover-figure">
            <ImageMod
              src={heroImage}
              width={1168}
              height={880}
              alt="A woman moving through soft curtains in a sunlit wellness courtyard"
              class="about-cover-image"
              format="webp"
              fit="cover"
              loading="eager"
            />
            <figcaption>
              <span>Issue note</span>
              A grounded guide to strength, nourishment, recovery, and steadier self-trust.
            </figcaption>
          </figure>
        </div>

        <div class="about-cover-meta" aria-label="About page themes">
          <span>Women’s wellbeing</span>
          <span>Evidence-informed practice</span>
          <span>Long-term change</span>
        </div>
      </div>
    </section>

    <section class="about-editorial-body">
      <div class="container">
        <div class="about-intro-strip">
          <span>Not another wellness checklist</span>
          <p>
            The work here begins with a quieter question: what actually helps
            you feel supported enough to keep going?
          </p>
        </div>

        <div class="about-journal-grid">
          <aside class="about-aside" aria-label="About page summary">
            <p>Modern wellness for women over 35</p>
            <span>Stronger. Steadier. More at home in your body.</span>
          </aside>

          <article class="about-article">
            <p class="about-kicker">Our philosophy</p>
            <div class="about-copy">
              <p>
                Becoming Elysian was created for you if you are over 35 and have
                grown tired of wellness that demands more discipline, more
                restriction, or more perfection.
              </p>
              <p>
                In a world full of conflicting advice and constant pressure to
                optimise, it is easy to feel disconnected from your own body —
                even while trying your best.
              </p>
              <p>
                Here, you will find a more grounded, intelligent approach. One
                that weaves together strength, nourishment, hormonal awareness,
                nervous system care, and sustainable rituals that fit the life
                you are already living.
              </p>
            </div>

            <div
              class="about-principles"
              aria-label="Becoming Elysian principles"
            >
              {
                principles.map((principle, index) => (
                  <section>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <div>
                      <h2>{principle.title}</h2>
                      <p>{principle.content}</p>
                    </div>
                  </section>
                ))
              }
            </div>

            <figure class="about-figure">
              <ImageMod
                src={articleImage}
                width={1672}
                height={941}
                alt="Becoming Elysian editorial wellness still life"
                class="about-figure-image"
                format="webp"
                fit="cover"
                loading="lazy"
              />
            </figure>

            <blockquote class="about-reveal-quote about-reveal-text">
              {
                revealQuoteWords.map(({ word, delay }) => (
                  <span
                    class="about-reveal-word"
                    style={`--about-word-delay: ${delay}`}
                  >
                    {word}{" "}
                  </span>
                ))
              }
            </blockquote>

            <div class="about-copy">
              <p>
                We explore wellness with a grounded and compassionate lens so
                you can build a life that feels strong, balanced, and truly
                your own.
              </p>
            </div>

            <div class="about-topic-spread">
              <div>
                <p class="about-kicker">What we cover</p>
                <h2>A fuller map of women’s health.</h2>
              </div>
              <div
                class="about-topic-list"
                aria-label="Topics Becoming Elysian covers"
              >
                {
                  topics.map((topic, index) => (
                    <span>
                      <small>{String(index + 1).padStart(2, "0")}</small>
                      {topic}
                    </span>
                  ))
                }
              </div>
            </div>

            <hr />

            <p class="about-kicker">Our background</p>
            <div class="about-copy">
              <p>
                Becoming Elysian is shaped by more than six years of coaching
                women through real-life change, fitness education, nutrition
                guidance, mobility work, and the kind of support that actually
                lasts.
              </p>
              <p>
                This work has supported thousands of women navigating stress,
                body changes, shifting energy, and the desire for wellness that
                fits their full lives.
              </p>
            </div>

            <div class="about-detail-grid">
              <div>
                <h3>ISSA certifications</h3>
                <ul>
                  {credentials.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h3>Practical experience</h3>
                <ul>
                  {experience.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>

            <div class="about-copy">
              <p>
                What shaped Becoming Elysian most was seeing how many capable,
                caring women were quietly struggling — not because they lacked
                willpower, but because the approaches they followed asked too
                much and gave too little in return.
              </p>
              <p>
                True wellbeing grows through steady nourishment, movement you
                enjoy, recovery that restores you, and habits that feel
                sustainable over time.
              </p>
            </div>

            <div class="about-final-note">
              <span>Editorial promise</span>
              <p>
                Becoming Elysian exists to be useful in your ordinary days, not
                just beautiful in the quiet moments after reading.
              </p>
            </div>

            <p class="about-closing">
              Our hope is that you leave here feeling more informed, more
              capable, and a little more at peace in your body.
            </p>
          </article>
        </div>
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  const loadAboutTextReveal = () => {
    const revealTargets = document.querySelectorAll(".about-reveal-text");
    if (!revealTargets.length) return;

    const reveal = (target) => {
      target.classList.add("is-revealed");
    };

    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !("IntersectionObserver" in window)
    ) {
      revealTargets.forEach(reveal);
      return;
    }

    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -12% 0px",
        threshold: 0.15,
      },
    );

    revealTargets.forEach((target) => {
      if (target.dataset.revealObserved === "true") return;
      target.dataset.revealObserved = "true";
      observer.observe(target);
    });
  };

  document.addEventListener("astro:page-load", loadAboutTextReveal);
  loadAboutTextReveal();
</script>

<style>
  .about-magazine {
