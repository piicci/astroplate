---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Newsletter"
  meta_title="Newsletter | Becoming Elysian"
  description="Join the weekly Becoming Elysian wellness letter for calm, practical guidance on nutrition, strength, hormones, stress, recovery, and sustainable habits."
  image="/images/becoming-elysian-about-editorial.png"
>
  <section class="section-sm newsletter-page bg-[linear-gradient(112deg,transparent_0%,rgba(154,103,64,0.04)_14%,transparent_26%),radial-gradient(circle_at_78%_8%,rgba(232,215,189,0.22),transparent_28rem),linear-gradient(180deg,rgba(248,241,230,0.98),rgba(255,249,239,0.74))]">
    <div class="container">
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div class="max-w-2xl">
          <p class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-primary">
            The weekly wellness letter
          </p>
          <h1 class="mb-6">A calmer way to stay connected to your wellbeing</h1>
          <div class="space-y-5">
            <p>
              Join the Becoming Elysian newsletter for thoughtful, evidence-informed notes on nutrition, strength, hormones, stress, recovery, and sustainable wellness for women.
            </p>
            <p>
              No extremes. No overwhelm. Just grounded guidance to help you feel more supported in your body and your daily life.
            </p>
          </div>
        </div>

        <form class="newsletter-page-form rounded-sm border border-border/70 bg-white/32 p-6 shadow-[0_26px_78px_-60px_rgba(23,19,13,0.3)] dark:border-darkmode-border dark:bg-darkmode-light/35 md:p-8" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="newsletter" />
          <input type="hidden" name="source" value="newsletter-page" />
          <input type="hidden" name="subject" value="New newsletter signup" />
          <p class="hidden" aria-hidden="true">
            <label>Do not fill this out: <input name="bot-field" /></label>
          </p>
          <div class="grid gap-5">
            <div>
              <label class="form-label" for="newsletter-page-first-name">First name</label>
              <input class="form-input" id="newsletter-page-first-name" name="firstName" type="text" placeholder="First name" autocomplete="given-name" required />
              <p class="mt-2 min-h-5 text-sm text-text-light">So we can greet you warmly.</p>
              <p class="mt-2 hidden text-sm text-[#9f3f32]" data-error-name>Please enter your first name.</p>
            </div>
            <div>
              <label class="form-label" for="newsletter-page-email">Email address</label>
              <input class="form-input" id="newsletter-page-email" name="email" type="email" placeholder="Email address" autocomplete="email" required />
              <p class="mt-2 min-h-5 text-sm text-text-light">Weekly notes, no noise.</p>
              <p class="mt-2 hidden text-sm text-[#9f3f32]" data-error-email>Please enter a valid email address.</p>
            </div>
          </div>
          <button class="btn btn-primary mt-6 w-full active:translate-y-[1px] sm:w-auto" type="submit" data-submit-label="Join the Weekly Letter">
            Join the Weekly Letter
          </button>
          <p class="mt-5 text-sm text-text-light">
            Thoughtful, practical, and easy to return to.
          </p>
          <p class="be-form-message be-form-message--success mt-4 hidden" data-success>
            You're in. Your first weekly letter is on its way.
          </p>
          <p class="be-form-message be-form-message--error mt-4 hidden" data-error-submit>
            We couldn't send this just yet. Please try again.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    const newsletterPageForms = document.querySelectorAll(".newsletter-page-form");
    const submitNetlifyForm = async (form) => {
      const isLocal = ["localhost", "127.0.0.1"].includes(window.location.hostname);

      if (isLocal) {
        await new Promise((resolve) => window.setTimeout(resolve, 350));
        return;
      }

      const response = await fetch("/__forms.html", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(new FormData(form)).toString(),
      });

      if (!response.ok) {
        throw new Error("Form submission failed");
      }
    };

    newsletterPageForms.forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const botField = form.querySelector('[name="bot-field"]');
        const name = form.querySelector('[name="firstName"]');
        const email = form.querySelector('[name="email"]');
        const nameError = form.querySelector("[data-error-name]");
        const emailError = form.querySelector("[data-error-email]");
        const success = form.querySelector("[data-success]");
        const submitError = form.querySelector("[data-error-submit]");
        const button = form.querySelector("button[type='submit']");
        const validEmail = email.value.trim().includes("@") && email.value.trim().includes(".");
        const validName = name.value.trim().length > 0;

        if (botField?.value) {
          return;
        }

        nameError.classList.toggle("hidden", validName);
        emailError.classList.toggle("hidden", validEmail);
        success.classList.add("hidden");
        submitError.classList.add("hidden");

        if (!validName || !validEmail) {
          return;
        }

        button.disabled = true;
        button.textContent = "Joining...";

        try {
          await submitNetlifyForm(form);
          success.classList.remove("hidden");
          form.reset();
        } catch (error) {
          submitError.classList.remove("hidden");
        } finally {
          button.disabled = false;
          button.textContent = button.dataset.submitLabel;
        }
      });
    });
  </script>

  <style is:inline>
    .newsletter-page h1 {
      color: #17130d;
      font-size: 2.75rem;
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1;
    }

    .newsletter-page p:not([class*="text-sm"]) {
      color: #201a10;
      font-size: 1.04rem;
      letter-spacing: 0.01em;
      line-height: 1.62;
    }

    @media (min-width: 768px) {
      .newsletter-page h1 {
        font-size: 3.65rem;
      }
    }

    @media (max-width: 767px) {
      .newsletter-page p:not([class*="text-sm"]) {
        font-size: var(--be-mobile-copy-size);
        line-height: var(--be-mobile-copy-line-height);
      }
    }
  </style>
</Base>
