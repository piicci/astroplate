---
import Base from "@/layouts/Base.astro";
import BreakfastGuideForm from "@/layouts/components/BreakfastGuideForm.astro";

const journeys = [
  {
    eyebrow: "Journey 01",
    title: "If you feel tired and overwhelmed",
    body: "Begin by supporting your energy before asking more of yourself. This path starts with blood sugar, meals, stress, and the small daily rhythms that help your body feel steadier.",
    links: [
      {
        label: "Why You Feel Tired After Eating",
        href: "/journal/why-you-feel-tired-after-eating-and-what-may-help",
        note: "Notice what may be draining your energy after meals.",
      },
      {
        label: "Simple Ways to Reduce Afternoon Energy Crashes",
        href: "/journal/simple-ways-to-reduce-afternoon-energy-crashes",
        note: "Build a softer afternoon rhythm with food, hydration, sleep, and movement.",
      },
      {
        label: "Cravings, Blood Sugar, and Stress",
        href: "/journal/cravings-blood-sugar-and-stress",
        note: "Understand why cravings often ask for support, not more willpower.",
      },
    ],
    cta: {
      label: "Explore Blood Sugar & Energy",
      href: "/journal/categories/blood-sugar--energy",
    },
  },
  {
    eyebrow: "Journey 02",
    title: "If your body feels different after 35",
    body: "Start here when your energy, appetite, strength, hormones, or body composition feel unfamiliar. This path helps you meet those changes with nourishment, muscle, and steadier metabolic support.",
    links: [
      {
        label: "Metabolic Health for Women Over 35",
        href: "/journal/metabolic-health-for-women-over-35",
        note: "Get the wider map before changing everything at once.",
      },
      {
        label: "Why Your Metabolism Changes in Your 30s and 40s",
        href: "/journal/why-your-metabolism-changes-in-your-30s-and-40s",
        note: "See what may be shifting, and what actually helps.",
      },
      {
        label: "How Much Protein Do Women Over 35 Really Need?",
        href: "/journal/how-much-protein-do-women-over-35-need",
        note: "Anchor your meals with enough support for muscle, recovery, and fullness.",
      },
      {
        label: "Why Eating Less Is Not Always Better for Your Metabolism",
        href: "/journal/why-eating-less-is-not-always-better-for-your-metabolism",
        note: "Move away from restriction and toward a body that feels better fed.",
      },
    ],
    cta: {
      label: "Explore Metabolic Health",
      href: "/journal/categories/metabolic-health",
    },
  },
  {
    eyebrow: "Journey 03",
    title: "If you want a routine you can actually sustain",
    body: "Begin with practices you can return to on ordinary days. This path keeps wellness simple: balanced plates, easy protein, satisfying meals, and rhythm over perfection.",
    links: [
      {
        label: "A Simple Balanced Plate Method",
        href: "/journal/simple-balanced-plate-method-for-women",
        note: "Use one calm formula when nutrition feels noisy.",
      },
      {
        label: "Protein Timing: Does It Matter for Women?",
        href: "/journal/protein-timing-does-it-matter-for-women",
        note: "Spread support through the day without turning meals into a stopwatch.",
      },
      {
        label: "High-Protein Breakfast Ideas for Steady Energy",
        href: "/journal/high-protein-breakfast-ideas-for-steady-energy",
        note: "Make the first meal feel more grounding and less accidental.",
      },
      {
        label: "Mediterranean Diet for Women Over 40",
        href: "/journal/mediterranean-diet-for-women-over-40",
        note: "Let your longer-term rhythm be generous, colorful, and realistic.",
      },
    ],
    cta: {
      label: "Explore Foundational Nutrition",
      href: "/journal/categories/foundational-nutrition",
    },
  },
];
---

<Base
  title="Start Here"
  meta_title="Start Here | Becoming Elysian"
  description="Begin with Becoming Elysian pathways for stress, recovery, metabolism, hormones, and sustainable habits."
  image="/images/becoming-elysian-about-editorial.png"
>
  <section class="start-here-intro">
    <div class="container start-here-breathe">
      <p class="start-here-eyebrow">Start here</p>
      <h1>Begin with what your body is asking for.</h1>
      <p class="start-here-lede">
        You do not need to change everything at once. Choose the area that
        feels most relevant to your life right now, then build from there with
        steadiness and care.
      </p>
    </div>
  </section>

  <section class="start-here-pathways">
    <div class="container start-here-breathe">
      <div class="start-here-list">
        {
          journeys.map((journey) => (
            <article class="start-here-journey">
              <div class="start-here-journey-copy">
                <p class="start-here-eyebrow">{journey.eyebrow}</p>
                <h2>{journey.title}</h2>
                <p>{journey.body}</p>
                <a class="start-here-category-link" href={journey.cta.href}>
                  {journey.cta.label}
                </a>
              </div>
              <ol class="start-here-steps" aria-label={`${journey.title} articles`}>
                {journey.links.map((link, index) => (
                  <li>
                    <a href={link.href}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <strong>{link.label}</strong>
                      <small>{link.note}</small>
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="start-here-guide" id="breakfast-guide" aria-labelledby="start-guide-title">
    <div class="container start-here-breathe">
      <div class="start-here-guide-panel">
        <div>
          <p class="start-here-eyebrow">Breakfast guide</p>
          <h2 id="start-guide-title">7 high-protein breakfasts for steadier mornings</h2>
          <p>
            If your mornings often begin with coffee, a rushed bite, or a meal
            that does not quite hold you, start here. This PDF gives you seven
            simple breakfast ideas built around protein, fiber, and satisfying
            fats so the rest of the day can feel a little steadier.
          </p>
        </div>

        <BreakfastGuideForm
          idPrefix="start-here-breakfast-guide"
          source="start-here-breakfast-guide"
          className="start-here-guide-form"
        />
      </div>
    </div>
  </section>

  <style>
    .start-here-intro {
      padding: clamp(4.25rem, 8vw, 7rem) 0 clamp(2rem, 4vw, 3rem);
      overflow-x: clip;
    }

    .start-here-breathe {
      width: min(calc(100vw - 3rem), 70rem) !important;
      max-width: 70rem;
    }

    .start-here-eyebrow {
      margin: 0 0 1.15rem;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      line-height: 1.2;
      text-transform: uppercase;
      color: #8e9475;
    }

    .start-here-intro h1 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(2.5rem, 4.6vw, 4.6rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 0.96;
      color: #2a251d;
    }

    .start-here-lede {
      max-width: 43rem;
      margin: clamp(1.6rem, 3vw, 2.35rem) 0 0;
      font-size: clamp(1rem, 1.25vw, 1.12rem);
      line-height: 1.62;
      color: #4b3b25;
    }

    .start-here-pathways {
      padding: clamp(1.25rem, 3vw, 2rem) 0 clamp(4rem, 8vw, 7rem);
      overflow-x: clip;
    }

    .start-here-list {
      display: grid;
      gap: clamp(2.75rem, 6vw, 5.5rem);
    }

    .start-here-journey {
      display: grid;
      gap: clamp(1.75rem, 5vw, 4.5rem);
      padding: clamp(2rem, 4.5vw, 3.5rem) 0;
      border-top: 1px solid rgba(220, 201, 167, 0.86);
    }

    .start-here-journey:last-child {
      border-bottom: 1px solid rgba(220, 201, 167, 0.86);
    }

    .start-here-journey-copy {
      display: grid;
      gap: 1rem;
      align-content: start;
      min-width: 0;
    }

    .start-here-list h2 {
      max-width: 13ch;
      margin: 0;
      font-size: clamp(2.15rem, 3.7vw, 3.45rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1;
      color: #4b3b25;
    }

    .start-here-list p,
    .start-here-guide p {
      max-width: 43rem;
      margin: 0;
      font-size: clamp(1rem, 1.25vw, 1.1rem);
      line-height: 1.66;
      color: #6f5b3b;
    }

    .start-here-category-link {
      width: fit-content;
      margin-top: 0.35rem;
      color: #3f4a14;
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-decoration: underline;
      text-decoration-color: rgba(138, 114, 76, 0.38);
      text-underline-offset: 0.45rem;
      text-transform: uppercase;
    }

    .start-here-steps {
      display: grid;
      gap: 0;
      width: 100%;
      min-width: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid rgba(138, 114, 76, 0.26);
    }

    .start-here-steps li {
      min-width: 0;
      border-bottom: 1px solid rgba(138, 114, 76, 0.26);
    }

    .start-here-steps a {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: clamp(0.9rem, 2vw, 1.4rem);
      padding: clamp(1.05rem, 2.5vw, 1.45rem) 0;
      color: #2a251d;
      transition:
        color 220ms ease,
        transform 220ms ease;
    }

    .start-here-steps a:hover {
      color: #3f4a14;
      transform: translateX(0.25rem);
    }

    .start-here-steps span {
      padding-top: 0.2rem;
      color: #8e9475;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      line-height: 1.2;
    }

    .start-here-steps strong {
      display: block;
      min-width: 0;
      font-family: var(--font-secondary);
      font-size: clamp(1.45rem, 2.5vw, 2.1rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.04;
      overflow-wrap: break-word;
    }

    .start-here-steps small {
      display: block;
      grid-column: 2;
      max-width: 36rem;
      margin-top: 0.55rem;
      color: #6f5b3b;
      font-size: clamp(0.94rem, 1vw, 1rem);
      line-height: 1.55;
    }

    .start-here-guide {
      border-block: 1px solid rgba(220, 201, 167, 0.85);
      padding: clamp(4rem, 8vw, 7rem) 0;
      overflow-x: clip;
      background:
        radial-gradient(circle at 88% 12%, rgba(142, 148, 117, 0.24), transparent 24rem),
        linear-gradient(135deg, rgba(237, 226, 204, 0.8), rgba(247, 243, 232, 0.96));
    }

    .start-here-guide-panel {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
      max-width: 70rem;
    }

    .start-here-guide h2 {
      max-width: 12ch;
      margin: 0 0 1.4rem;
      font-size: clamp(2.25rem, 3.8vw, 3.6rem);
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1;
      color: #2a251d;
    }

    .start-here-guide-form {
      width: 100%;
      max-width: 30rem;
      border-top: 1px solid rgba(138, 114, 76, 0.34);
      padding-top: clamp(1.5rem, 3vw, 2rem);
    }

    .start-here-guide-form .form-input {
      background-color: rgba(247, 243, 232, 0.74);
    }

    @media (min-width: 1024px) {
      .start-here-journey {
        grid-template-columns: minmax(16rem, 0.42fr) minmax(0, 1fr);
      }

      .start-here-guide-panel {
        grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.42fr);
      }
    }

    .dark .start-here-intro h1,
    .dark .start-here-list h2,
    .dark .start-here-guide h2 {
      color: #f7f3e8;
    }

    .dark .start-here-lede,
    .dark .start-here-list p,
    .dark .start-here-guide p,
    .dark .start-here-steps small {
      color: #ede2cc;
    }

    .dark .start-here-category-link,
    .dark .start-here-steps a {
      color: #f7f3e8;
    }

    @media (max-width: 767px) {
      .start-here-lede,
      .start-here-list p,
      .start-here-guide p {
        font-size: var(--be-mobile-copy-size);
        line-height: var(--be-mobile-copy-line-height);
      }

      .start-here-steps a {
        grid-template-columns: 2.35rem minmax(0, 1fr);
        transform: none;
      }

      .start-here-steps a:hover {
        transform: none;
      }

      .start-here-steps strong {
        font-size: clamp(1.22rem, 5.8vw, 1.45rem);
        line-height: 1.1;
        overflow-wrap: anywhere;
      }

      .start-here-breathe {
        width: min(calc(100vw - 2rem), 70rem) !important;
      }
    }
  </style>
</Base>
