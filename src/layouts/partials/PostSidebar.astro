---
import { humanize } from "@/lib/utils/textConverter";

const {
  tags,
  categories,
  allCategories,
  allTags = [],
  categoryEntries = [],
} = Astro.props;

const tagCounts = allTags.reduce((counts: Record<string, number>, tag: string) => {
  counts[tag] = (counts[tag] || 0) + 1;
  return counts;
}, {});
const sortedTags = [...tags].sort(
  (a: string, b: string) =>
    (tagCounts[b] || 0) - (tagCounts[a] || 0) || a.localeCompare(b),
);
const sortedCategories =
  categoryEntries.length > 0
    ? [...categoryEntries].sort(
        (a: { label: string; count: number }, b: { label: string; count: number }) =>
          b.count - a.count || a.label.localeCompare(b.label),
      )
    : categories.map((category: string) => ({
        slug: category,
        label: humanize(category),
        count: allCategories.filter((c: string) => c === category).length,
      }));
---

<div class="lg:col-4">
  <!-- categories -->
  <div class="mb-8">
    <h5 class="mb-6">Categories</h5>
    <div class="rounded-sm border border-border/70 bg-body/70 p-8 shadow-[0_18px_60px_-52px_rgba(23,19,13,0.32)] dark:border-darkmode-border dark:bg-darkmode-light">
      <ul class="space-y-4">
        {
          sortedCategories.map((category: any) => {
            return (
              <li>
                <a
                  class="flex justify-between hover:text-primary dark:hover:text-darkmode-primary"
                  href={`/journal/categories/${category.slug}`}
                >
                  {category.label} <span>({category.count})</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <!-- tags -->
  <div class="mb-8">
    <h5 class="mb-6">Tags</h5>
    <div class="rounded-sm border border-border/70 bg-body/70 p-6 shadow-[0_18px_60px_-52px_rgba(23,19,13,0.32)] dark:border-darkmode-border dark:bg-darkmode-light">
      <ul>
        {
          sortedTags.map((tag: any) => {
            return (
              <li class="inline-block">
                <a
                  class="m-1 block rounded-full border border-border/60 bg-body/80 px-3 py-1 text-sm hover:border-primary hover:bg-primary hover:text-white dark:border-darkmode-border dark:bg-darkmode-body dark:hover:bg-darkmode-primary dark:hover:text-text-dark"
                  href={`/tags/${tag}`}
                >
                  {humanize(tag)}
                  {tagCounts[tag] && (
                    <span class="ml-1 text-xs opacity-70">({tagCounts[tag]})</span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>
