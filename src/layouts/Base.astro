---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

// destructure frontmatter
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  ogType = "website",
  structuredData,
} = Astro.props;

const siteUrl = config.site.base_url.replace(/\/$/, "");
const pageTitle = plainify(
  meta_title ? meta_title : title ? title : config.site.title,
).trim();
const pageDescription = plainify(
  description ? description : config.metadata.meta_description,
).trim();
const toAbsoluteUrl = (src?: string) => {
  const value = src || config.metadata.meta_image;

  if (!value) {
    return "";
  }

  if (/^https?:\/\//.test(value)) {
    return value;
  }

  return `${siteUrl}${value.startsWith("/") ? value : `/${value}`}`;
};

const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const canonicalUrl = canonical ? toAbsoluteUrl(canonical) : pageUrl;
const metaImage = toAbsoluteUrl(image);
const globalStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: config.site.title,
    url: siteUrl,
    logo: toAbsoluteUrl(config.site.logo),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: config.site.title,
    url: siteUrl,
    description: config.metadata.meta_description,
    publisher: {
      "@type": "Organization",
      name: config.site.title,
    },
  },
];
const pageStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const jsonLd = [...globalStructuredData, ...pageStructuredData];
const stringifyJsonLd = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png"
    />
    <!-- theme meta -->
    <meta name="theme-name" content="becoming-elysian" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#F8F1E6"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#201A10"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} item-prop="url" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${config.site.title} RSS Feed`}
      href={`${siteUrl}/rss.xml`}
    />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <style is:inline>
      html body .container {
        width: min(calc(100% - clamp(3rem, 7vw, 7rem)), 1280px) !important;
        max-width: 1280px !important;
        margin-inline: auto !important;
        padding-inline: 0 !important;
      }

      @media (max-width: 480px) {
        html body .container {
          width: min(calc(100% - 48px), 1280px) !important;
        }
      }
    </style>

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={config.site.title} />

    <!-- og-description -->
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- twitter-title -->
    <meta name="twitter:title" content={pageTitle} />

    <!-- twitter-description -->
    <meta name="twitter:description" content={pageDescription} />

    <!-- og-image -->
    <meta property="og:image" content={metaImage} />

    <!-- twitter-image -->
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      jsonLd.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={stringifyJsonLd(item)}
        />
      ))
    }
  </head>
  <body class="flex flex-col min-h-screen">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <Announcement client:only="react" />
    <Header />
    {
      config.settings.search && (
        <script>import "@/layouts/helpers/search-modal-loader";</script>
      )
    }
    <main class="grow overflow-x-hidden w-full max-w-full" id="main-content">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
  </body>
</html>
