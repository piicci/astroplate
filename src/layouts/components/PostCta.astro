---
import { markdownify } from "@/lib/utils/textConverter";

type Props = {
  enable?: boolean;
  eyebrow?: string;
  title?: string;
  body?: string;
  source?: string;
};

const {
  enable = true,
  eyebrow = "",
  title = "",
  body = "",
  source = "journal-post",
} = Astro.props;
const cleanEyebrow = eyebrow.trim();
const cleanTitle = title.trim();
const cleanBody = body.trim();
const hasContent = Boolean(enable && (cleanEyebrow || cleanTitle || cleanBody));
const formId = `post-cta-email-${source.replace(/[^a-z0-9-]/gi, "-")}`;
---

{
  hasContent && (
    <section
      class="be-post-cta"
      aria-labelledby={cleanTitle ? "post-cta-title" : undefined}
      aria-label={cleanTitle ? undefined : "Journal newsletter signup"}
    >
      <div class="be-post-cta-inner">
        <div class="be-post-cta-copy">
          {cleanEyebrow && (
            <p class="be-post-cta-eyebrow" set:html={markdownify(cleanEyebrow)} />
          )}

          {cleanTitle && (
            <h2 id="post-cta-title" set:html={markdownify(cleanTitle)} />
          )}

          {cleanBody && (
            <div class="be-post-cta-body" set:html={markdownify(cleanBody, true)} />
          )}
        </div>

        <form
          class="be-post-cta-form"
          name="newsletter"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <input type="hidden" name="source" value={`journal-post:${source}`} />
          <input type="hidden" name="subject" value="New newsletter signup" />
          <p class="hidden" aria-hidden="true">
            <label>Do not fill this out: <input name="bot-field" /></label>
          </p>

          <div class="be-post-cta-control">
            <div class="be-post-cta-field">
              <label class="form-label" for={formId}>Email address</label>
              <input
                class="form-input"
                id={formId}
                name="email"
                type="email"
                placeholder="Your email address"
                autocomplete="email"
                required
              />
              <p class="be-post-cta-error hidden" data-error>
                Please enter a valid email address.
              </p>
            </div>

            <button
              class="be-post-cta-button"
              type="submit"
              data-submit-label="Join the Letter"
            >
              Join the Letter
            </button>
          </div>

          <p class="be-post-cta-note">
            Weekly notes to help you feel steady, supported, and gently back in touch with yourself.
          </p>
          <p class="be-post-cta-success be-form-message be-form-message--success hidden" data-success>
            You're in. Your next weekly letter is on its way.
          </p>
          <p class="be-post-cta-submit-error be-form-message be-form-message--error hidden" data-error-submit>
            We couldn't send this just yet. Please try again.
          </p>
        </form>
      </div>
    </section>
  )
}

<script is:inline>
  const postCtaForms = document.querySelectorAll(".be-post-cta-form");
  const submitPostCtaForm = async (form) => {
    const isLocal = ["localhost", "127.0.0.1"].includes(window.location.hostname);

    if (isLocal) {
      await new Promise((resolve) => window.setTimeout(resolve, 350));
      return;
    }

    const response = await fetch("/__forms.html", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams(new FormData(form)).toString(),
    });

    if (!response.ok) {
      throw new Error("Form submission failed");
    }
  };

  postCtaForms.forEach((form) => {
    if (form.dataset.bound === "true") {
      return;
    }

    form.dataset.bound = "true";
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const botField = form.querySelector('[name="bot-field"]');
      const email = form.querySelector('[name="email"]');
      const error = form.querySelector("[data-error]");
      const success = form.querySelector("[data-success]");
      const submitError = form.querySelector("[data-error-submit]");
      const button = form.querySelector("button[type='submit']");
      const value = email.value.trim();
      const validEmail = value.includes("@") && value.includes(".");

      if (botField?.value) {
        return;
      }

      error.classList.toggle("hidden", validEmail);
      success.classList.add("hidden");
      submitError.classList.add("hidden");

      if (!validEmail) {
        return;
      }

      button.disabled = true;
      button.textContent = "Joining...";

      try {
        await submitPostCtaForm(form);
        success.classList.remove("hidden");
        form.reset();
      } catch (error) {
        submitError.classList.remove("hidden");
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.submitLabel;
      }
    });
  });
</script>
