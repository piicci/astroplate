---
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./ImageMod.astro";

const {
  summary_length,
  blog_folder,
}: { summary_length: number; blog_folder: string } = config.settings;
const { data } = Astro.props;
const { title, subtitle, image, date, author, categories } = data.data;
---

<div
  class="h-full border border-border/70 bg-body/76 p-5 shadow-[0_22px_70px_-56px_rgba(23,19,13,0.34)] transition duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:border-primary dark:border-darkmode-border dark:bg-darkmode-body sm:p-6"
>
  {
    image && (
      <div class="group mb-6 overflow-hidden rounded-sm border border-border/80 bg-light/45 p-1 dark:border-darkmode-border dark:bg-darkmode-light/60">
        <ImageMod
          class="aspect-[5/3] w-full rounded-sm object-cover brightness-[1.06] contrast-[1.05] saturate-[1.03] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
          src={image}
          alt={title}
          width={445}
          height={230}
          format="webp"
        />
      </div>
    )
  }
  <h4 class="mb-3 leading-none">
    <a href={`/${blog_folder}/${data.id}`}>
      <span>{title}</span>
      {
        subtitle && (
          <span class="be-article-subtitle">
            {subtitle}
          </span>
        )
      }
    </a>
  </h4>
  <ul class="mb-4 text-sm text-text-light">
    <li class="mr-4 inline-block">
      <a href={`/authors/${slugify(author)}`}>
        <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
        {humanize(author)}
      </a>
    </li>
    <li class="mr-4 inline-block">
      <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
      {
        categories.map((category: string, index: number) => (
          <a href={`/categories/${slugify(category)}`}>
            {humanize(category)}
            {index !== categories.length - 1 && ","}
          </a>
        ))
      }
    </li>
    {date && <li class="inline-block">{dateFormat(date)}</li>}
  </ul>
  <p class="mb-6 leading-7">{plainify(data.body?.slice(0, Number(summary_length)))}</p>
  <a class="btn btn-outline-primary btn-sm" href={`/${blog_folder}/${data.id}`}>
    Read More
  </a>
</div>
