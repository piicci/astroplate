---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const {
  src,
  srcDarkmode,
  width,
  height,
}: {
  src?: string;
  srcDarkmode?: string;
  width?: string | number;
  height?: string | number;
} = Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;
const logoSource = src ? src : logo;
const logoDarkSource = srcDarkmode ? srcDarkmode : logo_darkmode;
const logoFormat = logoSource?.endsWith(".svg") ? "svg" : "webp";
const logoDarkFormat = logoDarkSource?.endsWith(".svg") ? "svg" : "webp";
const isSvgLogo = logoSource?.endsWith(".svg");
const isSvgDarkLogo = logoDarkSource?.endsWith(".svg");
const displayWidth = String(width ?? logo_width).replace("px", "");
const displayHeight = String(height ?? logo_height).replace("px", "");
const logoStyle = `height:${displayHeight}px;width:${displayWidth}px`;
const lightLogoClass = ["inline-block", theme_switcher && "dark:hidden"]
  .filter(Boolean)
  .join(" ");
const darkLogoClass = "hidden dark:inline-block";
---

<a href="/" class="navbar-brand inline-block">
  {
    src || srcDarkmode || logo || logo_darkmode ? (
      <>
        {isSvgLogo ? (
          <img
            src={logoSource}
            class={lightLogoClass}
            width={Number(displayWidth) * 2}
            height={Number(displayHeight) * 2}
            alt={title}
            style={logoStyle}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        ) : (
          <ImageMod
            src={logoSource}
            class={lightLogoClass}
            width={Number(displayWidth) * 2}
            height={Number(displayHeight) * 2}
            alt={title}
            style={{
              height: displayHeight + "px",
              width: displayWidth + "px",
            }}
            format={logoFormat}
            loading="eager"
            fetchpriority="high"
          />
        )}
        {theme_switcher &&
          (isSvgDarkLogo ? (
            <img
              src={logoDarkSource}
              class={darkLogoClass}
              width={Number(displayWidth) * 2}
              height={Number(displayHeight) * 2}
              alt={title}
              style={logoStyle}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <ImageMod
              src={logoDarkSource}
              class={darkLogoClass}
              width={Number(displayWidth) * 2}
              height={Number(displayHeight) * 2}
              alt={title}
              style={{
                height: displayHeight + "px",
                width: displayWidth + "px",
              }}
              format={logoDarkFormat}
              loading="eager"
              fetchpriority="high"
            />
          ))}
      </>
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
