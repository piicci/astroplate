---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { resolveImageAsset } from "@/lib/utils/assetImages";

// Props interface for the component
interface Props {
  src: string | ImageMetadata;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  densities?: (number | `${number}x`)[];
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  style?: any;
}

// Destructuring Astro.props to get the component's props
let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  fit,
  densities,
  fetchpriority,
} = Astro.props;

const resolvedImage =
  typeof src === "string" ? await resolveImageAsset(src) : src;

// Log a warning message in red if the image is not found
typeof src === "string" &&
  src.startsWith("/images/") &&
  !resolvedImage &&
  console.error(
    `\x1b[31mImage not found - ${src}.\x1b[0m Make sure the image exists in src/assets/images or public/images.`,
  );

const imageSrc = resolvedImage ?? src;
---

{
  imageSrc && (
    <Image
      src={imageSrc as any}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fit={fit ? fit : "contain"}
      decoding={decoding ?? "async"}
      fetchpriority={fetchpriority}
      class={className}
      format={format}
      densities={densities}
      style={style}
    />
  )
}
