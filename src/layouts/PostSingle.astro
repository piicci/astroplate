---
import JournalCard from "@/components/JournalCard.astro";
import Comments from "@/components/Comments.astro";
import Share from "@/components/Share.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";
import PostCta from "./components/PostCta.astro";
import PostFaq from "./components/PostFaq.astro";
import PostTldr from "./components/PostTldr.astro";

const COLLECTION_FOLDER = "journal";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const {
  title,
  subtitle,
  description,
  author,
  categories,
  image,
  date,
  tags,
  tldr_enable,
  tldr_title,
  tldr_key_points,
  tldr_takeaway,
  faq_enable,
  faq_title,
  faq_subtitle,
  faq_items,
  post_cta_enable,
  post_cta_eyebrow,
  post_cta_title,
  post_cta_body,
} = post.data;
const showTldr = Boolean(tldr_enable);
const showFaq = Boolean(faq_enable);
const showPostCta = Boolean(post_cta_enable);
---

<section class="be-post-single section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="be-post-article lg:col-9 xl:col-8">
        {
          image && (
            <div class="be-post-hero-image mb-10">
              <ImageMod
                src={image}
                height={450}
                width={800}
                alt={title}
                class="aspect-[16/9] w-full rounded-sm object-cover brightness-[1.06] contrast-[1.05] saturate-[1.03]"
                format="webp"
                fit="cover"
                densities={[1, 2]}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          )
        }
        <h1 set:html={markdownify(title)} class="be-post-title mb-4" />
        {subtitle && <p class="be-article-subtitle mb-7">{subtitle}</p>}
        <ul class="be-post-meta mb-4">
          <li class="mr-4 inline-block">
            <a href={`/authors/${slugify(author)}`}>
              <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
              {humanize(author)}
            </a>
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {
              categories.map((category: string, index: number) => (
                <a href={`/categories/${slugify(category)}`}>
                  {humanize(category)}
                  {index !== categories.length - 1 && ","}
                </a>
              ))
            }
          </li>
          {
            date && (
              <li class="mr-4 inline-block">
                <FaRegClock className={"mr-2 -mt-1 inline-block"} />
                {dateFormat(date)}
              </li>
            )
          }
        </ul>
        {
          showTldr && (
            <PostTldr
              title={tldr_title}
              points={tldr_key_points}
              takeaway={tldr_takeaway}
            />
          )
        }
        <div class="content be-post-content mb-10">
          <Content />
        </div>
        {
          showFaq && (
            <PostFaq
              title={faq_title}
              subtitle={faq_subtitle}
              items={faq_items}
            />
          )
        }
        {
          showPostCta && (
            <PostCta
              enable={post_cta_enable}
              eyebrow={post_cta_eyebrow}
              title={post_cta_title}
              body={post_cta_body}
              source={post.id}
            />
          )
        }
        <div class="be-post-actions row items-start justify-between">
          <div class="mb-10 flex items-center lg:col-5 lg:mb-0">
            <h5 class="mr-3">Tags :</h5>
            <ul>
              {
                tags.map((tag: string) => (
                  <li class="inline-block">
                    <a
                      class="m-1 block rounded-full border border-border/60 bg-body/75 px-3 py-1 text-sm hover:border-primary hover:bg-primary hover:text-white dark:border-darkmode-border dark:bg-darkmode-light dark:hover:bg-darkmode-primary dark:hover:text-text-dark"
                      href={`/tags/${slugify(tag)}`}
                    >
                      {humanize(tag)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="flex items-center lg:col-4">
            <h5 class="mr-3">Share :</h5>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={`journal/${post.id}`}
            />
          </div>
        </div>
        <Comments />
      </article>
    </div>

    <!-- Related posts -->
    <div class="be-related-posts section pb-0">
      <h2 class="h3 mb-12 text-center">Related Posts</h2>
      <div class="row justify-center">
        {
          similarPosts.map((post) => (
            <div class="lg:col-4 md:col-6 mb-14">
              <JournalCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
