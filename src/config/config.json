{
  "site": {
    "title": "Becoming Elysian",
    "base_url": "https://becomingelysian.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/be-logo-monogram.svg",
    "logo_darkmode": "/images/be-logo-monogram.svg",
    "logo_width": "36",
    "logo_height": "46",
    "logo_text": "Becoming Elysian"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": false,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200
  },

  "announcement": {
    "enable": false,
    "content": "",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "© 2026 Becoming Elysian. All rights reserved."
  },

  "navigation_button": {
    "enable": true,
    "label": "Join Our Circle",
    "link": "/newsletter"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "comments": {
    "enable": true,
    "provider": "utterances",
    "title": "Join the conversation",
    "description": "Share a thoughtful note, question, or lived observation.",
    "giscus": {
      "repo": "piicci/becoming-elysian",
      "repo_id": "",
      "category": "General",
      "category_id": "",
      "mapping": "pathname",
      "strict": "0",
      "reactions_enabled": "1",
      "emit_metadata": "0",
      "input_position": "top",
      "lang": "en",
      "loading": "lazy"
    },
    "utterances": {
      "repo": "piicci/becoming-elysian",
      "issue_term": "pathname",
      "label": "journal-comment"
    }
  },

  "metadata": {
    "meta_author": "Becoming Elysian",
    "meta_image": "/images/og-image.png",
    "meta_description": "Becoming Elysian is a modern wellness platform for women exploring fitness, nutrition, hormonal health, stress, recovery, and sustainable wellbeing through a grounded, evidence-informed lens."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": [
      "brevo-*",
      "elements",
      "authors",
      "categories",
      "tags",
      "journal/page"
    ]
  }
}
